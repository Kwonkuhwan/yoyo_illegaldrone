  m_Script: {fileID: 11500000, guid: 543d2116c251f36498bf9763d2c0026d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  str_LoginTitle: "\uB85C\uADF8\uC778 \uC548\uB0B4"
  sprite_Login: {fileID: 21300000, guid: dac1c8c5621997c42b0871e946178648, type: 3}
  str_Login: "HMD\uB97C \uB0B4\uB824\uB193\uACE0 \uAD50\uAD00\uC758 \uC548\uB0B4\uC5D0
    \uB530\uB77C \uB85C\uADF8\uC778\uC744 \uC9C4\uD589\uD574 \uC8FC\uC138\uC694."
  str_LogoutTitle: "\uB85C\uADF8\uC544\uC6C3 \uC548\uB0B4"
  sprite_Logout: {fileID: 21300000, guid: bac0bc6325cdfa340983b13d37612eb7, type: 3}
  sprite_LogoutIcon: {fileID: 21300000, guid: d1a8327e2b978b149b8b5a8dde279b49, type: 3}
  str_Logout: "\uD6C8\uB828 \uC7AC\uC124\uC815\uC744 \uC704\uD574 \uB85C\uADF8\uC544\uC6C3
    \uB418\uC5C8\uC2B5\uB2C8\uB2E4. HMD\uB97C \uBC97\uACE0 \uC790\uB9AC\uC5D0\uC11C
    \uC7A0\uC2DC \uB300\uAE30\uD574 \uC8FC\uC138\uC694."
  str_DuplicateLoginTitle: "\uC911\uBCF5 \uB85C\uADF8\uC778 \uC548\uB0B4"
  sprite_DuplicateLogin: {fileID: 21300000, guid: 2bd8504835c629a44ba3262b4f811395,
    type: 3}
  sprite_DuplicateLoginIcon: {fileID: 0}
  str_DuplicateLogin: "\uB3D9\uC77C\uD55C \uACC4\uC815\uC73C\uB85C \uC911\uBCF5 \uB85C\uADF8\uC778\uC774
    \uB418\uC5B4 \uB85C\uADF8\uC544\uC6C3\uB418\uC5C8\uC2B5\uB2C8\uB2E4. HMD\uB97C
    \uBC97\uACE0 \uB85C\uADF8\uC778\uC744 \uD655\uC778\uD574 \uC8FC\uC138\uC694."
  str_ChangePasswordTitle: "\uB85C\uADF8\uC544\uC6C3 \uC548\uB0B4"
  sprite_ChangePassword: {fileID: 21300000, guid: bac0bc6325cdfa340983b13d37612eb7,
    type: 3}
  sprite_ChangePasswordIcon: {fileID: 21300000, guid: c520e69444134e240a1195eb10050e41,
    type: 3}
  str_ChangePassword: "\uD328\uC2A4\uC6CC\uB4DC \uC815\uBCF4\uAC00 \uBCC0\uACBD\uB418\uC5B4
    \uB85C\uADF8\uC544\uC6C3\uB418\uC5C8\uC2B5\uB2C8\uB2E4. HMD\uB97C \uBC97\uACE0
    \uBCC0\uACBD\uB41C \uD328\uC2A4\uC6CC\uB4DC\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694."
